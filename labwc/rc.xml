<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>

  <theme>
    <cornerRadius>8</cornerRadius>
    <font name="sans" size="10" />
  </theme>

  <keyboard>
    <default />

    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" />
    </keybind>

    <keybind key="W-Return">
      <action name="Execute" command="qterminal" />
    </keybind>

    <keybind key="Print">
      <action name="Execute" command="sh -c $HOME/.local/bin/way-screenshot.sh" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
    
    <context name="Frame">
      <mousebind button="W-left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="W-right" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>

    <context name="Client">
      <mousebind button="W-left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="W-right" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>
  </mouse>

</labwc_config>
